          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', fm.measured_at) AS time, ds.name AS metric, avg(fm.value) AS value FROM fact_measurements fm JOIN dim_station ds ON ds.station_id = fm.station_id JOIN dim_pollutant dp ON dp.pollutant_id = fm.pollutant_id WHERE $__timeFilter(fm.measured_at) AND dp.code = 'pm25' GROUP BY 1, ds.name ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Günlük PM₂.₅ Ortalaması — İstasyon Karşılaştırma",
